                  }
                ]
              },
              "highlights": null
            }
          }
        }
      }]
    ]
  },

  "partiallyMalformedGroups": {
    "_comment": "One amenity group is garbage. The healthy groups around it must survive.",
    "niobeClientData": [
      ["StaysPdpSectionsQuery", {
        "data": {
          "node": {
            "pdpPresentation": {
              "amenities": {
                "seeAllAmenitiesGroups": [
